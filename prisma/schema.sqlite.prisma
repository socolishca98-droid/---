// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// СИСТЕМА ПОЛЬЗОВАТЕЛЕЙ И АВТОРИЗАЦИЯ
// ============================================

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  salt         String
  role         String    @default("logist") // admin | logist
  status       String    @default("pending_approval") // pending_approval | active | deactivated
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@index([role])
}

// ============================================
// ATI.SU ИНТЕГРАЦИЯ
// ============================================

model AtiScanConfig {
  id               String    @id @default(cuid())
  name             String    @default("default")
  cities           String    @default("[]")
  radius           Int       @default(200)
  truckTypes       String    @default("any")
  minWeight        Int?
  autoScanInterval Int       @default(0)
  isActive         Boolean   @default(true)
  lastScanAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AtiCache {
  id            String    @id @default(cuid())
  atiLoadId     String    @unique
  routeFrom     String
  routeFromId   String?
  routeTo       String
  routeToId     String?
  distance      Int?
  weight        Int?
  volume        Float?
  cargoType     String?
  truckType     String?
  loadingType   String?
  price         Int?
  priceType     String?
  paymentType   String?
  vatIncluded   Boolean   @default(false)
  loadingDate   DateTime?
  unloadingDate DateTime?
  firmId        String?
  firmName      String?
  contactName   String?
  contactPhone  String?
  note          String?
  rawJson       String?
  status        String    @default("new")
  aiScore       Int?
  aiReason      String?
  scannedAt     DateTime  @default(now())
  expiresAt     DateTime

  @@index([status])
  @@index([scannedAt])
  @@index([routeFrom, routeTo])
}

model AtiSession {
  id        String   @id @default(cuid())
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ============================================
// КЭШИРОВАНИЕ ГЕОКОДИНГА
// ============================================

model GeoCache {
  id        String   @id @default(cuid())
  address   String   @unique
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@index([address])
}

// ============================================
// МАРШРУТЫ И РЕЙСЫ
// ============================================

model Route {
  id            String       @id @default(cuid())
  name          String?      // Например "Рейс #101: Москва — Тверь — СПб"
  status        String       @default("planned") // planned | active | in_transit | completed | cancelled
  driverId      String?
  driver        Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId     String?
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  startedAt     DateTime?
  completedAt   DateTime?
  totalDistance Int?         // км
  totalCost     Int?         // руб
  fuelExpense   Int?         // руб
  cargoWeight   Int?         // кг
  cargoVolume   Float?       // м3
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders        Order[]
  stages        RouteStage[]
  events        RouteEvent[]

  @@index([status])
  @@index([driverId])
  @@index([vehicleId])
}

// ============================================
// ОСНОВНЫЕ СУЩНОСТИ
// ============================================

model Order {
  id                String    @id @default(cuid())
  source            String
  sourceId          String?
  routeFrom         String
  routeTo           String
  distance          Int
  weight            Int
  volume            Float?
  cargoType         String
  loadingType       String    @default("other")
  requirements      String?
  price             Int?
  priceNegotiable   Boolean   @default(false)
  paymentType       String?
  vatType           String?
  deferredDays      Int?
  isPaid            Boolean   @default(false)
  paidAt            DateTime?
  dueDate           DateTime?
  clientName        String?
  clientContact     String
  clientFirmId      String?
  deadline          DateTime
  status            String    @default("new")
  priority          String    @default("needs_clarification")
  aiScore           Int       @default(50)
  aiReason          String?

  assignedDriverId  String?
  driver            Driver?   @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)

  assignedVehicleId String?
  vehicle           Vehicle?  @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)

  routeId           String?
  route             Route?    @relation(fields: [routeId], references: [id], onDelete: SetNull)

  // Догруз
  isAdditionalLoad  Boolean   @default(false)
  addedToRouteAt    DateTime?
  proposedToDriver  Boolean   @default(false)
  proposedAt        DateTime?
  acceptedAt        DateTime?
  rejectedAt        DateTime?
  rejectionReason   String?
  routeSequence     Int?

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([routeId])
  @@index([routeId, routeSequence])
  @@index([assignedDriverId, status])
  @@index([assignedVehicleId, status])
  @@index([proposedToDriver])
}

/// Водитель
/// Допустимые значения status: available, busy, maintenance, offline
model Driver {
  id              String            @id @default(cuid())
  name            String
  phone           String            @unique
  vehicleId       String?
  vehicle         Vehicle?          @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  vehicleType     String
  vehiclePlate    String
  currentLocation String?
  latitude        Float?
  longitude       Float?
  lastGpsUpdate   DateTime?
  /// Статус водителя: available | busy | maintenance | offline
  status          String            @default("available")
  ordersCompleted Int               @default(0)
  rating          Float             @default(5.0)
  licenseNumber   String?
  licenseExpiry   DateTime?
  medicalExpiry   DateTime?
  hiredAt         DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  orders          Order[]
  routes          Route[]
  shifts          DriverShift[]
  sosAlerts       SosAlert[]
  photos          Photo[]
  maintenanceLogs MaintenanceLog[]
  stages          RouteStage[]
  events          RouteEvent[]

  @@index([status])
  @@index([vehicleId])
}

/// Транспортное средство
/// Допустимые значения status: available, in_use, maintenance
model Vehicle {
  id                  String           @id @default(cuid())
  plate               String           @unique
  type                String
  brand               String?
  model               String?
  year                Int?
  capacity            Int
  volume              Float?
  length              Float?
  width               Float?
  height              Float?
  features            String           @default("[]")
  /// Статус ТС: available | in_use | maintenance
  status              String           @default("available")
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  mileage             Int?
  insuranceExpiry     DateTime?
  inspectionExpiry    DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  drivers             Driver[]
  orders              Order[]
  routes              Route[]
  maintenanceLogs     MaintenanceLog[]
  stages              RouteStage[]
  events              RouteEvent[]

  @@index([status])
}

// ============================================
// СМЕНА ВОДИТЕЛЯ
// ============================================

model DriverShift {
  id                      String       @id @default(cuid())
  driverId                String
  driver                  Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  startedAt               DateTime     @default(now())
  endedAt                 DateTime?
  status                  String       @default("driving")
  totalDrivingSeconds     Int          @default(0)
  totalRestingSeconds     Int          @default(0)
  totalLoadingSeconds     Int          @default(0)
  totalWaitingSeconds     Int          @default(0)
  drivingSinceRestSeconds Int          @default(0)
  lastStatusChangeAt      DateTime     @default(now())
  events                  ShiftEvent[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([driverId])
  @@index([status])
  @@index([startedAt])
}

model ShiftEvent {
  id        String      @id @default(cuid())
  shiftId   String
  shift     DriverShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type      String
  latitude  Float?
  longitude Float?
  address   String?
  metadata  String?
  createdAt DateTime    @default(now())

  @@index([shiftId])
  @@index([type])
}

// ============================================
// SOS СИГНАЛЫ
// ============================================

model SosAlert {
  id          String    @id @default(cuid())
  driverId    String
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  orderId     String?
  type        String
  message     String?
  latitude    Float
  longitude   Float
  address     String?
  status      String    @default("active")
  respondedBy String?
  respondedAt DateTime?
  resolvedBy  String?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime  @default(now())

  @@index([driverId])
  @@index([status])
}

// ============================================
// УВЕДОМЛЕНИЯ
// ============================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  userRole  String
  type      String
  title     String
  message   String
  driverId  String?
  orderId   String?
  photoId   String?
  sosId     String?
  routeId   String?
  priority  String    @default("normal")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([priority])
  @@index([routeId])
}

// ============================================
// ЧАТ / СООБЩЕНИЯ
// ============================================

model ChatMessage {
  id              String    @id @default(cuid())
  senderId        String
  senderRole      String
  senderName      String
  recipientId     String?
  content         String
  type            String    @default("text")
  isImportant     Boolean   @default(false)
  importantReason String?
  attachmentUrl   String?
  isRead          Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([isImportant])
  @@index([createdAt])
}

// ============================================
// ФОТО
// ============================================

model Photo {
  id          String   @id @default(cuid())
  url         String
  type        String
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  orderId     String?
  description String?
  ocrText     String?
  ocrData     String?
  createdAt   DateTime @default(now())

  @@index([driverId])
  @@index([orderId])
  @@index([type])
}

// ============================================
// ЖУРНАЛ ТО / РЕМОНТОВ
// ============================================

model MaintenanceLog {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId    String?
  driver      Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  type        String
  description String
  mileage     Int?
  cost        Int?
  performer   String    @default("driver")
  serviceName String?
  status      String    @default("in_progress")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
}

model FleetSettings {
  id          String   @id @default("default")
  parkName    String   @default("Наш Автопарк")
  baseAddress String?
  baseLat     Float?
  baseLng     Float?
  updatedAt   DateTime @updatedAt
}

// ============================================
// ЭТАПЫ МАРШРУТА И СОБЫТИЯ
// ============================================

model RouteStage {
  id             String    @id @default(cuid())
  routeId        String
  route          Route     @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orderId        String?
  driverId       String?
  driver         Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId      String?
  vehicle        Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  type           String   // loading | driving | unloading | rest | other
  status         String    @default("planned") // planned | active | completed | cancelled
  sequence       Int?
  plannedStartAt DateTime?
  plannedEndAt   DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([routeId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([type])
  @@index([status])
}

model RouteEvent {
  id        String   @id @default(cuid())
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orderId   String?
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  stageId   String?
  type      String   // location | status | photo | sos | note | eta_update | custom
  status    String?
  latitude  Float?
  longitude Float?
  address   String?
  data      String?  // JSON с деталями события
  createdAt DateTime @default(now())

  @@index([routeId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String   // who performed action
  actorEmail String?
  action     String   // approve | deactivate | activate | change_role | etc
  targetId   String?  // affected user id
  targetType String   @default(\"user\") // user | driver | vehicle | etc
  targetEmail String?
  metadata   String?  // JSON string with details (old role, new role, etc)
  ip         String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@index([createdAt])
}
