// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============================================
// ATI.SU ИНТЕГРАЦИЯ
// ============================================

model AtiScanConfig {
  id               String    @id @default(cuid())
  name             String    @default("default")
  cities           String    @default("[]")
  radius           Int       @default(200)
  truckTypes       String    @default("any")
  minWeight        Int?
  autoScanInterval Int       @default(0)
  isActive         Boolean   @default(true)
  lastScanAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model AtiCache {
  id            String    @id @default(cuid())
  atiLoadId     String    @unique
  routeFrom     String
  routeFromId   String?
  routeTo       String
  routeToId     String?
  distance      Int?
  weight        Int?
  volume        Float?
  cargoType     String?
  truckType     String?
  loadingType   String?
  price         Int?
  priceType     String?
  paymentType   String?
  vatIncluded   Boolean   @default(false)
  loadingDate   DateTime?
  unloadingDate DateTime?
  firmId        String?
  firmName      String?
  contactName   String?
  contactPhone  String?
  note          String?
  rawJson       String?
  status        String    @default("new")
  aiScore       Int?
  aiReason      String?
  scannedAt     DateTime  @default(now())
  expiresAt     DateTime

  @@index([status])
  @@index([scannedAt])
  @@index([routeFrom, routeTo])
}

model AtiSession {
  id        String   @id @default(cuid())
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

// ============================================
// КЭШИРОВАНИЕ ГЕОКОДИНГА
// ============================================

model GeoCache {
  id        String   @id @default(cuid())
  address   String   @unique
  lat       Float
  lng       Float
  createdAt DateTime @default(now())

  @@index([address])
}

// ============================================
// МАРШРУТЫ И РЕЙСЫ
// ============================================

/// Рейс: один водитель + одна машина + один или несколько заказов.
/// Раньше «маршрут» был просто строкой routeId в заказах — ни статуса,
/// ни времени, ни итогов рейса хранить было негде.
/// Допустимые значения status: planned | active | in_transit | completed | cancelled
model Route {
  id            String       @id @default(cuid())
  /// Человекочитаемое название, например «Рейс: Ярославль — Иваново — СПб»
  name          String?
  status        String       @default("planned")
  driverId      String?
  driver        Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId     String?
  vehicle       Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  /// Фактическое время начала и конца рейса
  startedAt     DateTime?
  completedAt   DateTime?
  /// Итоги рейса: км, расходы руб, топливо руб, вес кг, объём м3
  totalDistance Int?
  totalCost     Int?
  fuelExpense   Int?
  cargoWeight   Int?
  cargoVolume   Float?
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  orders        Order[]
  stages        RouteStage[]
  events        RouteEvent[]

  @@index([status])
  @@index([driverId])
  @@index([vehicleId])
  @@index([createdAt])
}

// ============================================
// ОСНОВНЫЕ СУЩНОСТИ
// ============================================

model Order {
  id                String    @id @default(cuid())
  source            String
  sourceId          String?
  routeFrom         String
  routeTo           String
  distance          Int
  weight            Int
  volume            Float?
  cargoType         String
  loadingType       String    @default("other")
  requirements      String?
  price             Int?
  priceNegotiable   Boolean   @default(false)
  paymentType       String?
  vatType           String?
  deferredDays      Int?
  isPaid            Boolean   @default(false)
  paidAt            DateTime?
  dueDate           DateTime?
  clientName        String?
  clientContact     String
  clientFirmId      String?
  deadline          DateTime
  status            String    @default("new")
  priority          String    @default("needs_clarification")
  aiScore           Int       @default(50)
  aiReason          String?
  assignedDriverId  String?
  driver            Driver?   @relation(fields: [assignedDriverId], references: [id], onDelete: SetNull)

  assignedVehicleId String?
  vehicle           Vehicle?  @relation(fields: [assignedVehicleId], references: [id], onDelete: SetNull)

  /// Рейс, в который собран заказ (одна машина может везти несколько заказов)
  routeId           String?
  route             Route?    @relation(fields: [routeId], references: [id], onDelete: SetNull)

  // Догруз
  isAdditionalLoad Boolean   @default(false)
  addedToRouteAt   DateTime?
  proposedToDriver Boolean   @default(false)
  proposedAt       DateTime?
  acceptedAt       DateTime?
  rejectedAt       DateTime?
  rejectionReason  String?
  routeSequence    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Фото, сигналы SOS и точки маршрута, относящиеся к заказу
  photos     Photo[]
  sosAlerts  SosAlert[]
  stages     RouteStage[]
  routeEvents RouteEvent[]

  @@index([status])
  @@index([priority])
  @@index([source])
  @@index([routeId])
  @@index([routeId, routeSequence])
  @@index([assignedDriverId, status])
  @@index([assignedVehicleId, status])
  @@index([proposedToDriver])
}

/// Водитель
/// Допустимые значения status: available, busy, maintenance, offline
model Driver {
  id              String    @id @default(cuid())
  name            String
  /// Телефон — логин водителя в мобильном приложении, поэтому уникальный
  phone           String    @unique
  /// Единственное место, где хранится связь водитель<->машина.
  /// (Раньше она была продублирована в Vehicle.driverId и расходилась.)
  vehicleId       String?
  vehicle         Vehicle?  @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  /// Кэш для списков и уведомлений; синхронизируется с Vehicle при любом
  /// назначении через lib/fleet/assignment.ts — руками не менять
  vehicleType     String
  vehiclePlate    String
  currentLocation String?
  latitude        Float?
  longitude       Float?
  lastGpsUpdate   DateTime?
  /// Статус водителя: available | busy | maintenance | offline
  status          String    @default("available")
  ordersCompleted Int       @default(0)
  rating          Float     @default(5.0)
  licenseNumber   String?
  licenseExpiry   DateTime?
  medicalExpiry   DateTime?
  hiredAt         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  /// Учётная запись для входа в мобильное приложение (роль driver)
  user            User?

  orders          Order[]
  routes          Route[]
  shifts          DriverShift[]
  sosAlerts       SosAlert[]
  photos          Photo[]
  maintenanceLogs MaintenanceLog[]
  stages          RouteStage[]
  events          RouteEvent[]

  @@index([status])
  @@index([vehicleId])
}

/// Транспортное средство
/// Допустимые значения status: available, in_use, maintenance
model Vehicle {
  id                  String    @id @default(cuid())
  plate               String    @unique
  type                String
  brand               String?
  model               String?
  year                Int?
  capacity            Int
  volume              Float?
  length              Float?
  width               Float?
  height              Float?
  features            String    @default("[]")
  /// Статус ТС: available | in_use | maintenance
  status              String    @default("available")
  lastMaintenanceDate DateTime?
  nextMaintenanceDate DateTime?
  mileage             Int?
  insuranceExpiry     DateTime?
  inspectionExpiry    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  /// Закреплённый водитель — связь хранится на стороне Driver (Driver.vehicleId)
  drivers             Driver[]
  orders              Order[]
  routes              Route[]
  maintenanceLogs     MaintenanceLog[]
  stages              RouteStage[]
  events              RouteEvent[]

  @@index([status])
}

// ============================================
// СМЕНА ВОДИТЕЛЯ
// ============================================

model DriverShift {
  id                      String       @id @default(cuid())
  driverId                String
  driver                  Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  startedAt               DateTime     @default(now())
  endedAt                 DateTime?
  status                  String       @default("driving")
  totalDrivingSeconds     Int          @default(0)
  totalRestingSeconds     Int          @default(0)
  totalLoadingSeconds     Int          @default(0)
  totalWaitingSeconds     Int          @default(0)
  drivingSinceRestSeconds Int          @default(0)
  lastStatusChangeAt      DateTime     @default(now())
  events                  ShiftEvent[]
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  @@index([driverId])
  @@index([status])
  @@index([startedAt])
}

model ShiftEvent {
  id        String      @id @default(cuid())
  shiftId   String
  shift     DriverShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type      String
  latitude  Float?
  longitude Float?
  address   String?
  metadata  String?
  createdAt DateTime    @default(now())

  @@index([shiftId])
  @@index([type])
}

// ============================================
// SOS СИГНАЛЫ
// ============================================

model SosAlert {
  id          String    @id @default(cuid())
  driverId    String
  driver      Driver    @relation(fields: [driverId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?    @relation(fields: [orderId], references: [id], onDelete: SetNull)
  type        String
  message     String?
  latitude    Float
  longitude   Float
  address     String?
  status      String    @default("active")
  respondedBy String?
  respondedAt DateTime?
  resolvedBy  String?
  resolvedAt  DateTime?
  resolution  String?
  createdAt   DateTime  @default(now())

  @@index([driverId])
  @@index([status])
}

// ============================================
// УВЕДОМЛЕНИЯ
// ============================================

model Notification {
  id        String    @id @default(cuid())
  userId    String
  userRole  String
  type      String
  title     String
  message   String
  driverId  String?
  orderId   String?
  photoId   String?
  sosId     String?
  routeId   String?
  priority  String    @default("normal")
  isRead    Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([priority])
  @@index([routeId])
}

// ============================================
// ЧАТ / СООБЩЕНИЯ
// ============================================

model ChatMessage {
  id              String    @id @default(cuid())
  senderId        String
  senderRole      String
  senderName      String
  recipientId     String?
  content         String
  type            String    @default("text")
  isImportant     Boolean   @default(false)
  importantReason String?
  attachmentUrl   String?
  isRead          Boolean   @default(false)
  readAt          DateTime?
  createdAt       DateTime  @default(now())

  @@index([senderId])
  @@index([recipientId])
  @@index([isImportant])
  @@index([createdAt])
}

// ============================================
// ФОТО
// ============================================

model Photo {
  id          String   @id @default(cuid())
  url         String
  type        String
  driverId    String
  driver      Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  description String?
  ocrText     String?
  ocrData     String?
  createdAt   DateTime @default(now())

  @@index([driverId])
  @@index([orderId])
  @@index([type])
}

// ============================================
// ЖУРНАЛ ТО / РЕМОНТОВ
// ============================================

model MaintenanceLog {
  id          String    @id @default(cuid())
  vehicleId   String
  vehicle     Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId    String?
  driver      Driver?   @relation(fields: [driverId], references: [id], onDelete: SetNull)
  type        String
  description String
  mileage     Int?
  cost        Int?
  performer   String    @default("driver")
  serviceName String?
  status      String    @default("in_progress")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([vehicleId])
  @@index([driverId])
  @@index([status])
}

model FleetSettings {
  id          String   @id @default("default")
  parkName    String   @default("Наш Автопарк")
  baseAddress String?
  baseLat     Float?
  baseLng     Float?
  updatedAt   DateTime @updatedAt
}

// ============================================
// ЭТАПЫ МАРШРУТА И СОБЫТИЯ
// ============================================

model RouteStage {
  id             String   @id @default(cuid())
  routeId        String
  route          Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  driverId       String?
  driver         Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicleId      String?
  vehicle        Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  type           String   // loading | driving | unloading | rest | other
  status         String   @default("planned") // planned | active | completed | cancelled
  sequence       Int?
  plannedStartAt DateTime?
  plannedEndAt   DateTime?
  startedAt      DateTime?
  endedAt        DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([routeId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([type])
  @@index([status])
}

model RouteEvent {
  id        String   @id @default(cuid())
  routeId   String
  route     Route    @relation(fields: [routeId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  vehicleId String?
  vehicle   Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  stageId   String?
  type      String   // location | status | photo | sos | note | eta_update | custom
  status    String?
  latitude  Float?
  longitude Float?
  address   String?
  data      String?  // JSON с деталями события
  createdAt DateTime @default(now())

  @@index([routeId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([type])
  @@index([createdAt])
}

// ============================================
// АВТОРИЗАЦИЯ: ПОЛЬЗОВАТЕЛИ И СЕССИИ
// ============================================

/// Учётная запись человека, который входит в систему.
/// роли: admin | logist | driver
/// статусы: pending (ожидает одобрения) | active (доступ разрешён) | suspended (доступ закрыт)
/// Для роли driver обязателен phone и связь с Driver, email может отсутствовать.
/// Для ролей admin/logist обязателен email.
model User {
  id           String   @id @default(cuid())
  /// Email — уникальный идентификатор входа для admin/logist
  email        String?  @unique
  /// Телефон — уникальный идентификатор входа для driver
  phone        String?  @unique
  name         String
  /// Хэш пароля (scrypt, hex). Проверяется на сервере, наружу никогда не отдаётся
  passwordHash String
  /// Соль пароля (hex, 16 байт). Хранится отдельно от хэша
  passwordSalt String
  role         String   @default("logist")
  status       String   @default("pending")

  /// Ссылка на карточку водителя (только для role = "driver")
  driverId     String?  @unique
  driver       Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)

  /// Кто одобрил регистрацию
  approvedById String?
  approvedBy   User?    @relation("UserApprovals", fields: [approvedById], references: [id], onDelete: SetNull)
  approvals    User[]   @relation("UserApprovals")
  approvedAt   DateTime?

  /// Блокировка доступа (увольнение). Запись не удаляется — доступ можно восстановить
  suspendedAt   DateTime?
  suspendReason String?
  restoredAt    DateTime?
  restoredById  String?

  mustChangePassword Boolean  @default(false)
  lastLoginAt        DateTime?
  failedLoginCount   Int      @default(0)
  lockedUntil        DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sessions  Session[]

  @@index([status])
  @@index([role])
  @@index([role, status])
}

/// Серверная сессия. id = jti подписанного токена в httpOnly-cookie.
/// Удаление/отзыв строки немедленно закрывает доступ — это настоящий серверный выход.
model Session {
  id         String    @id
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       String
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?
  revokeReason String?
  lastSeenAt DateTime?
  userAgent  String?
  ip         String?

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}
