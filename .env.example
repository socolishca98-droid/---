# P0 hardened env example
# Database
DATABASE_URL="file:./dev.db"

# Auth - REQUIRED in production, generate with: openssl rand -hex 32
AUTH_SECRET="change_this_to_a_secure_random_string_at_least_32_chars_long"
NEXTAUTH_SECRET="change_this_to_a_secure_random_string_at_least_32_chars_long"

# Admin default password - set in production, defaults to random if not set
ADMIN_DEFAULT_PASSWORD="demo_for_dev_only_change_in_prod"

# ATI Integration
ATI_CLIENT_ID=
ATI_DEBUG=false
ATI_TOKEN=
CRON_SECRET="generate_secure_random_for_cron"

# Traffic
TRAFFIC_PROVIDER=
YANDEX_ROUTING_API_KEY=
YANDEX_ROUTING_API_URL=

# Node env
NODE_ENV=development
