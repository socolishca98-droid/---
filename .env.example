# ==============================================================================
# Loginex — пример конфигурации. Скопируйте в .env и заполните реальными значениями.
#   cp .env.example .env
# Файл .env в git НЕ попадает (см. .gitignore).
# ==============================================================================

# --- База данных ---
# Схема Prisma выбирается автоматически по протоколу DATABASE_URL:
#   file:...        → prisma/schema.prisma          (SQLite, локальная разработка)
#   postgresql://…  → prisma/schema.postgres.prisma (PostgreSQL/Supabase, прод)
# Ничего переключать вручную не нужно: npm run db:push / db:generate / build
# сами берут нужную схему (scripts/prisma-schema.mjs).
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/loginex?schema=public"

# --- Supabase (прод) ---
# Supabase → Project Settings → Database → Connection string.
# DATABASE_URL — пулер (Transaction pooler, порт 6543): приложение на Vercel
#   работает из serverless-функций, поэтому без пулера быстро закончатся
#   соединения. Параметры pgbouncer=true и connection_limit=1 обязательны.
# DATABASE_URL="postgresql://postgres.abcdefgh:ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
#
# DIRECT_URL — прямое подключение (порт 5432): нужно только командам, которые
#   меняют схему (npm run db:push). Транзакционный пулер их не пропускает.
#   Если прямой адрес db.<ref>.supabase.co не резолвится (он IPv6-only),
#   используйте Session pooler — тот же pooler-хост, но порт 5432.
# DIRECT_URL="postgresql://postgres.abcdefgh:ПАРОЛЬ@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"
#
# Пароль со спецсимволами кодируйте: @ → %40, # → %23, / → %2F.

# --- Авторизация (ОБЯЗАТЕЛЬНО) ---
# Секрет подписи сессионных токенов (HMAC-SHA256). Минимум 32 байта.
# Сгенерировать: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
# При смене секрета все активные сессии становятся недействительными.
AUTH_SECRET=""

# Время жизни сессии в часах (по умолчанию 12)
AUTH_SESSION_TTL_HOURS="12"

# --- Первый администратор (сид-скрипт) ---
# npm run seed:auth — создаёт администратора из этих переменных,
# а также учётки водителей для уже существующих записей Driver.
ADMIN_EMAIL="admin@loginex.local"
ADMIN_PASSWORD=""
ADMIN_NAME="Администратор"
# Организация, которой принадлежат данные (npm run seed:auth, npm run db:migrate-orgs)
ORGANIZATION_NAME="Название вашей организации"

# Стартовый пароль для учётных записей водителей, созданных сид-скриптом.
# Водитель меняет его при первом входе (Профиль → Сменить пароль).
DRIVER_DEFAULT_PASSWORD=""

# --- ATI.SU ---
ATI_CLIENT_ID=""
ATI_TOKEN=""
ATI_DEBUG="false"

# --- Планировщик сканирования ATI ---
CRON_SECRET=""

# --- Трафик / маршрутизация ---
# mock | yandex
TRAFFIC_PROVIDER="mock"
YANDEX_ROUTING_API_KEY=""
YANDEX_ROUTING_API_URL="https://api.routing.yandex.net/v2/route"

# --- Sentry (необязательно) ---------------------------------------------------
# Без DSN интеграция полностью отключена: next.config.mjs не подключает withSentryConfig
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Токен нужен только для загрузки sourcemap при сборке прод-бандла
SENTRY_AUTH_TOKEN=""

# --- PostgreSQL (продакшн) ----------------------------------------------------
# Разработочная БД — SQLite (DATABASE_URL="file:./dev.db").
# Для PostgreSQL: сгенерируйте схему (npm run schema:postgres) и укажите URL ниже.
# DATABASE_URL="postgresql://loginex:CHANGE_ME@localhost:5432/loginex?schema=public"
