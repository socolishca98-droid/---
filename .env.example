# P0 hardened env example + P2-1 PostgreSQL ready + P2-2 Sentry
# Database - SQLite for local dev
DATABASE_URL="file:./dev.db"
# For PostgreSQL production, use:
# DATABASE_URL="postgresql://user:password@localhost:5432/loginex?schema=public"
# And use prisma/schema.postgres.prisma (copy over schema.prisma) then `npx prisma migrate dev`
# Or set DATABASE_PROVIDER=postgresql and use that schema

# Sentry - P2-2 error monitoring (optional)
# Get DSN from https://sentry.io
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN= # for sourcemap upload

# Auth - REQUIRED in production, generate with: openssl rand -hex 32
AUTH_SECRET="change_this_to_a_secure_random_string_at_least_32_chars_long"
NEXTAUTH_SECRET="change_this_to_a_secure_random_string_at_least_32_chars_long"

# Admin default password - set in production, defaults to random if not set
ADMIN_DEFAULT_PASSWORD="demo_for_dev_only_change_in_prod"

# ATI Integration
ATI_CLIENT_ID=
ATI_DEBUG=false
ATI_TOKEN=
CRON_SECRET="generate_secure_random_for_cron"

# Traffic
TRAFFIC_PROVIDER=
YANDEX_ROUTING_API_KEY=
YANDEX_ROUTING_API_URL=

# Node env
NODE_ENV=development
