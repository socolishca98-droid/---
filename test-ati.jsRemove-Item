const ATI_TOKEN = "15e69c8cf7234414803510bb85ead015"

async function test() {
  console.log("TEST: today-plus + Moscow geo + hideHidden=false\n")
  
  const body = {
    page: 1,
    items_per_page: 50,
    filter: {
      loading: {
        geo: {
          type: 1,
          list: [3611],
          radius: 500
        }
      },
      hideHiddenLoads: false,
      sortingType: 0
    }
  }
  
  console.log("Body:", JSON.stringify(body))
  
  const r = await fetch("https://loads.ati.su/webapi/v1.0/loads/search", {
    method: "POST",
    headers: {
      "Authorization": "Bearer " + ATI_TOKEN,
      "Content-Type": "application/json"
    },
    body: JSON.stringify(body)
  })
  
  const d = await r.json()
  console.log("\nStatus:", r.status)
  console.log("Total:", d.totalItems)
  console.log("Loads:", d.loads?.length)
  console.log("hideHiddenLoads:", d.userFilter?.filter?.hideHiddenLoads)
  
  if (d.loads?.length > 0) {
    console.log("\nFIRST:", d.loads[0].loading?.location?.city, "->", d.loads[0].unloading?.location?.city)
    console.log("Price:", d.loads[0].rate?.priceNds)
  }
  
  require("fs").writeFileSync("out.json", JSON.stringify(d,null,2))
}

test()